{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ratulx.tech"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://ratulx.tech/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.also.ratulruhan.cv"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://also.ratulruhan.cv/$1"
      }
    },
    {
      "src": "^/api/mcp/?$",
      "dest": "/api/mcp.mjs"
    },
    {
      "src": "^/(bn)?/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "dest": "/ratul-hasan-ruhan.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Content-Language": "en",
        "Vary": "Accept",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300, s-maxage=3600",
        "Link": "<https://ratulx.tech/>; rel=\"alternate\"; type=\"text/html\", <https://ratulx.tech/ratul-hasan-ruhan.json>; rel=\"describedby\"; type=\"application/ld+json\""
      }
    },
    {
      "src": "^/(projects|awards|communities|research|writing|experience|contact|resume|recognition|writings|writting|about|profile)(/.*)?/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "dest": "/ratul-hasan-ruhan.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Content-Language": "en",
        "Vary": "Accept",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300, s-maxage=3600",
        "Link": "<https://ratulx.tech/>; rel=\"alternate\"; type=\"text/html\", <https://ratulx.tech/ratul-hasan-ruhan.json>; rel=\"describedby\"; type=\"application/ld+json\""
      }
    },
    {
      "src": "^/recognition/?$",
      "status": 308,
      "headers": {
        "Location": "/awards/"
      }
    },
    {
      "src": "^/writings/?$",
      "status": 308,
      "headers": {
        "Location": "/writing/"
      }
    },
    {
      "src": "^/writting/?$",
      "status": 308,
      "headers": {
        "Location": "/writing/"
      }
    },
    {
      "src": "^/resume/?$",
      "status": 308,
      "headers": {
        "Location": "/experience/"
      }
    },
    {
      "src": "^/about/?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/profile/?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "Link": "<https://ratulx.tech/ratul-hasan-ruhan.json>; rel=\"describedby\"; type=\"application/ld+json\", <https://ratulx.tech/ratul-hasan-ruhan.md>; rel=\"alternate\"; type=\"text/markdown\", <https://ratulx.tech/sitemap.xml>; rel=\"alternate\"; type=\"application/xml\", <https://ratulx.tech/.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\"",
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "/ratul-hasan-ruhan\\.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/ratul-hasan-ruhan\\.json",
      "headers": {
        "Content-Type": "application/ld+json; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/agent/portfolio\\.json",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/\\.well-known/api-catalog",
      "headers": {
        "Content-Type": "application/linkset+json; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300, s-maxage=3600"
      },
      "continue": true
    },
    {
      "src": "/openapi\\.json",
      "headers": {
        "Content-Type": "application/vnd.oai.openapi+json;version=3.1; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300, s-maxage=3600"
      },
      "continue": true
    },
    {
      "src": "/auth\\.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300, s-maxage=3600"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ]
}
